#!/bin/bash

if [ $# -eq 0 ]; then
  exit 0
fi

MAPPING=$(tailscale status --json 2>/dev/null | jq -r '.Peer // {} | to_entries[] | select(.value.Online == true) | "\(.value.HostName) (\(.value.TailscaleIPs[0]))|\(.value.TailscaleIPs[0])|\(.value.HostName)"' 2>/dev/null)

if [ -z "$MAPPING" ]; then
  omarchy notification send "Taildrop" "No online peers found" -u normal -g 󰒊 2>/dev/null
  exit 1
fi

OPTIONS=()
while IFS='|' read -r label ip host; do
  [ -z "$label" ] && continue
  OPTIONS+=("$label")
done <<< "$MAPPING"

TARGET_LABEL=""
if [ ${#OPTIONS[@]} -eq 1 ]; then
  TARGET_LABEL="${OPTIONS[0]}"
else
  TARGET_LABEL=$(omarchy-menu-select "Send to..." "${OPTIONS[@]}" || true)
fi

if [ -n "$TARGET_LABEL" ]; then
  TARGET_IP=""
  TARGET_NAME=""
  while IFS='|' read -r label ip host; do
    if [ "$label" = "$TARGET_LABEL" ]; then
      TARGET_IP="$ip"
      TARGET_NAME="$host"
      break
    fi
  done <<< "$MAPPING"

  if [ -n "$TARGET_IP" ]; then
    "$(dirname "$0")/taildrop-direct-send" "$TARGET_IP" "$TARGET_NAME" "$@"
  fi
fi
